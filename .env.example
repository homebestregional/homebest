# Copy this file to .env.local for your computer, and add the same values in Vercel.
# In Vercel, paste values WITHOUT quotes.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://bublcfpnxtuyumhffnfr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The live web address, no slash at the end. NEXT_PUBLIC_SITE_URL does not work on the server, so use this.
SITE_URL=http://localhost:3000

# Pesapal (start with sandbox, switch to live when Pesapal approves Homebest)
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
# Optional. Leave empty and the site registers the IPN address by itself.
PESAPAL_IPN_ID=

# Order emails through Resend (optional; skipped if empty)
RESEND_API_KEY=
EMAIL_FROM=Homebest <orders@your-domain.co.ke>
SHOP_ORDER_EMAIL=

# Optional: Make.com webhook to post paid orders to WhatsApp
ORDER_WEBHOOK_URL=
